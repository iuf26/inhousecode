{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "inhousecode review configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "harness": {
      "type": "string",
      "enum": ["copilot", "claude-code", "codex", "hermes"],
      "description": "Which AI CLI backend to use for the review, repair, and explain agents."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixByDefault": {
          "type": "boolean",
          "description": "Automatically repair all static and AI findings unless --no-fix is supplied."
        }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preCommit": { "type": "boolean" },
        "agentStop": { "type": "boolean" }
      }
    },
    "static": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "autofix": { "type": "boolean" },
        "maxFixLoops": { "type": "integer", "minimum": 0, "maximum": 20 },
        "fixSeverity": { "type": "string", "enum": ["all", "blocking"] },
        "restageFixes": { "type": "boolean" },
        "semgrepConfigs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "timeoutSec": { "type": "integer", "minimum": 30, "maximum": 3600 },
        "autofixBlocking": { "type": "boolean" },
        "maxFixLoops": { "type": "integer", "minimum": 0, "maximum": 10 },
        "triageFindings": { "type": "boolean" },
        "verifyIntent": { "type": "boolean" },
        "impactAnalysis": { "type": "boolean" },
        "critiqueModel": { "type": "string" },
        "critiqueRounds": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "agentStop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": { "type": "boolean" },
        "ai": { "type": "boolean" },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "autoLaunch": { "type": "boolean" },
        "contextLines": { "type": "integer", "minimum": 0, "maximum": 25 },
        "model": { "type": "string" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "contextMaxChars": { "type": "integer", "minimum": 500, "maximum": 20000 },
        "recordSessions": { "type": "boolean" },
        "autoPromoteAfterReviews": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "not": { "const": 1 }
        }
      }
    },
    "adversarial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "maxLenses": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
