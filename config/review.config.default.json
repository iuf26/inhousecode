{
  "$schema": "./review.config.schema.json",
  "harness": "copilot",
  "review": {
    "fixByDefault": false
  },
  "triggers": {
    "preCommit": true,
    "agentStop": false
  },
  "static": {
    "enabled": true,
    "autofix": false,
    "maxFixLoops": 20,
    "fixSeverity": "all",
    "restageFixes": true,
    "semgrepConfigs": [
      "p/security-audit",
      "p/owasp-top-ten",
      "p/cwe-top-25",
      "p/python"
    ]
  },
  "ai": {
    "enabled": true,
    "model": "",
    "timeoutSec": 600,
    "autofixBlocking": true,
    "maxFixLoops": 3,
    "triageFindings": true,
    "verifyIntent": true,
    "impactAnalysis": true,
    "critiqueModel": "",
    "critiqueRounds": 2
  },
  "agentStop": {
    "static": true,
    "ai": false,
    "maxTurns": 20
  },
  "explain": {
    "enabled": true,
    "autoLaunch": true,
    "contextLines": 5,
    "model": ""
  },
  "memory": {
    "enabled": true,
    "contextMaxChars": 4000,
    "recordSessions": false,
    "autoPromoteAfterReviews": 3
  },
  "adversarial": {
    "enabled": false,
    "model": "",
    "maxLenses": 4
  }
}
