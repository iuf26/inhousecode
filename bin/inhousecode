#!/usr/bin/env bash
#
# inhousecode - a two-phase review gate for AI-generated code.
#
#   Phase 1  deterministic Semgrep analysis with a bounded repair loop
#   Phase 2  AI code review against governed OpenViking knowledge
#
# See README.md for the reasoning behind the two phases.

set -uo pipefail

VERSION="0.1.0"
EXIT_PASS=0
EXIT_BLOCKED=1
EXIT_USAGE=2
# Where the pre-commit shim is written, and the only value of core.hooksPath
# this tool will ever write or clear. See install_pre_commit.
HOOKS_DIR=".githooks"

SCRIPT_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INHOUSECODE_HOME="$(cd -- "$SCRIPT_PATH/.." && pwd)"
export INHOUSECODE_HOME

# shellcheck source=../lib/common.sh
source "$INHOUSECODE_HOME/lib/common.sh"

usage() {
  cat <<EOF
inhousecode $VERSION - smart review gate for AI-generated code

USAGE
  inhousecode review [options]     run the review gates
  inhousecode show <number>        show one finding and its source excerpt
  inhousecode explain              open a session over the last findings
  inhousecode init                 create .inhousecode/ in this repository
  inhousecode install-hooks [...]  install the pre-commit and/or agent-stop hook
  inhousecode uninstall-hooks      remove hooks installed by inhousecode
  inhousecode memory <cmd>         use the shared OpenViking memory policy
  inhousecode integrate <cmd>      install native Hermes/Codex skill commands
  inhousecode discover             propose candidate memory for this repo
  inhousecode doctor               check the local environment
  inhousecode version

REVIEW OPTIONS
  --pr <id|url>       review a pull request; its base branch and head commit
                      are resolved from GitHub or Azure DevOps automatically
  --ticket <id|url>  fetch the ticket the work came from as a second intent
                      source (GitHub issues via gh; other trackers via URL)
  --intent-file <p>  read a free-form statement of intent from a file (the
                      escape hatch for trackers this tool cannot fetch)
  --adversarial      heavy multi-lens review on the configured adversarial
                      model; for whole PRs, not every commit
  --staged            review the git index (default)
  --worktree          review uncommitted working-tree changes
  --diff <base-ref>   review the commits this branch adds on top of <base-ref>
                      (use when there is no PR yet, or no forge access)
  --path <path>       review every file under a path
  --mode <mode>       both | static | ai   (default: both)
  --no-fix            report only; never edit files
  --fix               repair all static and AI findings for this run
  --gate              non-interactive: no prompts, exit code is the verdict
  --verbose           stream full agent logs

INSTALL-HOOKS OPTIONS
  --pre-commit        install the git pre-commit hook
  --agent-stop        install the Copilot CLI agentStop hook
  (default: whatever triggers.* says in the resolved configuration)

MEMORY COMMANDS
  inhousecode memory init
      initialize the shared OpenViking namespace
  inhousecode memory candidate add <text>
      add unverified developer feedback to candidate_memory/inbox
  inhousecode memory view --prompt <question>
      search and display memory without changing it
  inhousecode memory context [options]
      build a review snapshot (internal/read-only command)
  inhousecode memory classify <candidate-id> [options]
      classify a candidate; safe project facts may promote automatically
  inhousecode memory promote <candidate-id> --target <scope> --reason <text>
      human-approved promotion to project or global knowledge
  inhousecode memory harvest [--lookback-days N]
      turn what OpenViking learned from review sessions into candidates
  inhousecode memory schedule install|uninstall|status [--hour H] [--minute M]
      run the harvest daily (launchd on macOS, cron elsewhere)
  OpenViking is the only persistent memory store. There is no local fallback.

HARNESS INTEGRATIONS
  inhousecode integrate install hermes|codex|all
  inhousecode integrate status [hermes|codex|all]
  inhousecode integrate uninstall hermes|codex|all
      install or remove the native Agent Skill command for a user account

DISCOVER OPTIONS
  --gate               non-interactive: write nothing, print what would change
  (an AI agent inspects the repo and proposes candidate memory; run
  once on a fresh repo, or any time the stack has changed significantly)

ENVIRONMENT
  COPILOT_BIN         explicit path to the Copilot CLI
  CLAUDE_CODE_BIN     explicit path to the Claude Code CLI
  HERMES_BIN          explicit path to the Hermes CLI
  CODEX_BIN           explicit path to the Codex CLI
  INHOUSECODE_HARNESS harness backend: copilot, claude-code, codex, hermes
  INHOUSECODE_OV_SESSION_USER  OpenViking user for review sessions
                      (default: inhousecode-<hash of the repository>)
  INHOUSECODE_VERBOSE=1  same as --verbose
EOF
}

require_repo() {
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    fail "inhousecode: not inside a git repository."
    exit $EXIT_USAGE
  }
  cd "$REPO_ROOT" || exit $EXIT_USAGE
  export REPO_ROOT
}

# --- review ------------------------------------------------------------------

TARGET_MODE="staged"
TARGET_PATH=""
GATE_MODE="both"
GATE_ONLY=0
NO_FIX=0
OVERRIDE_REASON=""
FIX_REQUESTED=0
# --diff / --pr mode: DIFF_BASE is what the user typed or what the forge
# reported, DIFF_MERGE_BASE is the commit the branch actually forked from, and
# DIFF_HEAD is the commit under review. Reviewing against the merge base and not
# the base tip is what keeps unrelated commits landed on the base branch out of
# scope. DIFF_HEAD is a resolved commit rather than the literal HEAD so a pull
# request can be reviewed without checking it out.
DIFF_BASE=""
# Set when the base ref has already been resolved authoritatively (--pr mode,
# where the forge named the branch and the remote-tracking ref is the truth).
# A stale local branch of the same name must not be preferred over it.
DIFF_BASE_REV=""
DIFF_MERGE_BASE=""
DIFF_HEAD="HEAD"
# Where diff mode reads file content: the reviewed commit, or the working tree
# once repairs are enabled and each round must see the previous round's fixes.
DIFF_SOURCE="commit"
PR_REFERENCE=""
PR_ID=""
PR_TITLE=""
PR_URL=""
PR_BASE_BRANCH=""
TICKET_REFERENCE=""
INTENT_FILE=""
ADVERSARIAL_REQUESTED=0

parse_review_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --staged)   TARGET_MODE="staged" ;;
      --worktree) TARGET_MODE="worktree" ;;
      --pr)
        shift
        [ "$#" -gt 0 ] || { fail "inhousecode: --pr needs a pull-request number or URL."; exit $EXIT_USAGE; }
        TARGET_MODE="diff"; PR_REFERENCE="$1"
        ;;
      --ticket)
        shift
        [ "$#" -gt 0 ] || { fail "inhousecode: --ticket needs an issue/ticket number or URL."; exit $EXIT_USAGE; }
        TICKET_REFERENCE="$1"
        ;;
      --intent-file)
        shift
        [ "$#" -gt 0 ] || { fail "inhousecode: --intent-file needs a file path."; exit $EXIT_USAGE; }
        INTENT_FILE="$1"
        ;;
      --adversarial) ADVERSARIAL_REQUESTED=1 ;;
      --diff|--base)
        shift
        [ "$#" -gt 0 ] || { fail "inhousecode: --diff needs a base ref, e.g. --diff main."; exit $EXIT_USAGE; }
        TARGET_MODE="diff"; DIFF_BASE="$1"
        ;;
      --path)
        shift
        [ "$#" -gt 0 ] || { fail "inhousecode: --path needs a value."; exit $EXIT_USAGE; }
        TARGET_MODE="path"; TARGET_PATH="$1"
        ;;
      --mode)
        shift
        case "${1:-}" in
          both|static|ai) GATE_MODE="$1" ;;
          *) fail "inhousecode: --mode must be both, static, or ai."; exit $EXIT_USAGE ;;
        esac
        ;;
      --no-fix)  NO_FIX=1 ;;
      --fix)     FIX_REQUESTED=1 ;;
      --gate)    GATE_ONLY=1 ;;
      --verbose) INHOUSECODE_VERBOSE=1 ;;
      -h|--help) usage; exit $EXIT_PASS ;;
      *) fail "inhousecode: unknown option '$1'."; exit $EXIT_USAGE ;;
    esac
    shift
  done
  export INHOUSECODE_VERBOSE="${INHOUSECODE_VERBOSE:-0}"
}

# Resolve --diff's base ref into the merge base with the reviewed commit. A bare
# branch name is also tried against 'origin/', because the base branch of a pull
# request is usually only present as a remote-tracking ref in a reviewer's
# checkout.
resolve_diff_base() {
  local resolved head
  head="$(git rev-parse --verify --quiet "${DIFF_HEAD}^{commit}")" || {
    fail "inhousecode: '$DIFF_HEAD' is not a commit to review."
    exit $EXIT_USAGE
  }
  DIFF_HEAD="$head"
  if [ -n "$DIFF_BASE_REV" ]; then
    resolved="$DIFF_BASE_REV"
  else
    resolved="$(git rev-parse --verify --quiet "${DIFF_BASE}^{commit}")" ||
      resolved="$(git rev-parse --verify --quiet "origin/${DIFF_BASE}^{commit}")" || {
        fail "inhousecode: '--diff $DIFF_BASE' is not a commit. Fetch it first: git fetch origin $DIFF_BASE"
        exit $EXIT_USAGE
      }
  fi
  DIFF_MERGE_BASE="$(git merge-base "$resolved" "$head" 2>/dev/null)" || {
    fail "inhousecode: '$DIFF_BASE' and the reviewed commit share no common ancestor."
    exit $EXIT_USAGE
  }
  if [ "$DIFF_MERGE_BASE" = "$head" ]; then
    good "inhousecode: nothing to review - no commits on top of $DIFF_BASE."
    exit $EXIT_PASS
  fi
  export DIFF_MERGE_BASE DIFF_HEAD
}

# --pr: ask the forge what the pull request actually is, so the reviewer only
# ever has to name it.
resolve_pr_target() {
  # shellcheck source=../lib/pr.sh
  source "$INHOUSECODE_HOME/lib/pr.sh"
  resolve_pull_request "$PR_REFERENCE" || exit $EXIT_USAGE
  DIFF_BASE="$PR_BASE_BRANCH"
  DIFF_BASE_REV="$PR_BASE_REV"
  DIFF_HEAD="$PR_HEAD_REV"
  say "${C_BOLD}PR #$PR_ID${C_RESET}${PR_TITLE:+ - $PR_TITLE}"
  say "  ${DIFF_HEAD:0:9} -> $PR_BASE_BRANCH${PR_URL:+   $PR_URL}"
}

# --ticket: fetch the ticket the work came from, as a second intent source.
# Best-effort: a ticket that cannot be fetched is reported and skipped, never
# fatal. Exports TICKET_* consumed by the intent brief in gate_ai.sh.
resolve_ticket_target() {
  # shellcheck source=../lib/pr.sh
  source "$INHOUSECODE_HOME/lib/pr.sh"
  # shellcheck source=../lib/ticket.sh
  source "$INHOUSECODE_HOME/lib/ticket.sh"
  if resolve_ticket "$TICKET_REFERENCE"; then
    export TICKET_ID TICKET_TITLE TICKET_URL TICKET_BODY
    say "${C_BOLD}Ticket ${TICKET_ID}${C_RESET}${TICKET_TITLE:+ - $TICKET_TITLE}"
  fi
}

# --intent-file: read a free-form statement of intent verbatim. The universal
# escape hatch for trackers this tool cannot reach (Jira behind SSO, Notion,
# a pasted spec). A missing or empty file is reported and skipped.
resolve_intent_file() {
  if [ ! -f "$INTENT_FILE" ]; then
    warn "inhousecode: --intent-file '$INTENT_FILE' not found; continuing without it."
    return 0
  fi
  INTENT_FILE_BODY="$(cat "$INTENT_FILE" 2>/dev/null)"
  if [ -z "$INTENT_FILE_BODY" ]; then
    warn "inhousecode: --intent-file '$INTENT_FILE' is empty; continuing without it."
    return 0
  fi
  export INTENT_FILE_BODY
  say "${C_BOLD}Intent file${C_RESET} - $INTENT_FILE"
}

# --adversarial: turn on the heavy multi-lens pass for this run. Requires an
# adversarial model to have been configured at install; without one, it falls
# back to the primary review model and says so.
enable_adversarial() {
  export INHOUSECODE_ADVERSARIAL_ENABLED=1
  if [ -z "${INHOUSECODE_ADVERSARIAL_MODEL:-}" ]; then
    warn "inhousecode: no adversarial model configured; lenses will run on the primary review model."
    warn "  Set adversarial.model in .inhousecode/config.json to use a different model."
  fi
}

prepare_cache() {
  INHOUSECODE_CACHE_ROOT="$REPO_ROOT/.inhousecode/cache/run-$$"
  export INHOUSECODE_CACHE_ROOT
  mkdir -p "$INHOUSECODE_CACHE_ROOT" || {
    fail "inhousecode: could not create $INHOUSECODE_CACHE_ROOT"
    exit $EXIT_USAGE
  }
  trap 'rm -rf -- "$INHOUSECODE_CACHE_ROOT"' EXIT
  trap 'exit 130' INT TERM
}

# The authoritative in-scope file list. Every gate and every fixer prompt reads
# this one file, so all phases judge exactly the same set of paths.
collect_target_files() {
  local list="$INHOUSECODE_CACHE_ROOT/scan-files.txt"
  case "$TARGET_MODE" in
    staged)
      git diff --cached --name-only --diff-filter=ACMRD > "$list"
      cp -f "$list" "$INHOUSECODE_CACHE_ROOT/staged-paths.txt"
      ;;
    worktree)
      {
        git diff --name-only --diff-filter=ACMRD
        git diff --cached --name-only --diff-filter=ACMRD
        git ls-files --others --exclude-standard
      } | sort -u > "$list"
      ;;
    diff)
      git diff --name-only --diff-filter=ACMRD "$DIFF_MERGE_BASE" "$DIFF_HEAD" | sort -u > "$list"
      ;;
    path)
      {
        git ls-files -- "$TARGET_PATH"
        git ls-files --others --exclude-standard -- "$TARGET_PATH"
      } | sort -u > "$list"
      ;;
  esac || return 1
  TARGET_FILE_COUNT="$(grep -c . "$list" 2>/dev/null || true)"
  TARGET_FILE_COUNT="${TARGET_FILE_COUNT:-0}"
}

print_summary() {
  step "Summary"
  [ "$STATIC_STATUS" != "not-run" ] &&
    say "  Static analysis : $STATIC_STATUS${STATIC_ERROR:+ - $STATIC_ERROR}"
  [ "$AI_STATUS" != "not-run" ] &&
    say "  AI code review  : $AI_STATUS${AI_ERROR:+ - $AI_ERROR}"
  print_summary_cost
}

# The cost line only exists when an agent could have been run at all. Guarding
# on the function rather than on a flag keeps print_summary usable from any
# path, including ones that never source the Copilot layer.
print_summary_cost() {
  command -v print_usage_summary >/dev/null 2>&1 && print_usage_summary
  return 0
}

gates_blocked() {
  case "$STATIC_STATUS" in fail|unavailable) return 0 ;; esac
  case "$AI_STATUS" in fail|unavailable) return 0 ;; esac
  return 1
}

# The developer always has the last word, but overriding is a deliberate,
# logged act rather than a silent default.
resolve_blocked() {
  local answer prompt choices
  if [ "$GATE_ONLY" = "1" ] || ! has_tty; then
    fail "inhousecode: BLOCKED. Fix the findings above, or bypass every hook once with 'git commit --no-verify'."
    return $EXIT_BLOCKED
  fi
  if [ "${INHOUSECODE_EXPLAIN_ENABLED:-0}" = "1" ]; then
    prompt=$'\n  [d] show raw gate output   [e] explain these findings\n  [w] record a team preference   [o] override and continue   [a] abort\n  > '
    choices='d, e, w, o, or a'
  else
    prompt=$'\n  [d] show raw gate output   [w] record a team preference\n  [o] override and continue   [a] abort\n  > '
    choices='d, w, o, or a'
  fi
  while :; do
    ask answer "$prompt"
    case "$answer" in
      d|D)
        [ -n "$STATIC_OUTPUT" ] && printf '\n--- static ---\n%s\n' "$STATIC_OUTPUT" > /dev/tty
        [ -n "$AI_OUTPUT" ] && printf '\n--- review ---\n%s\n' "$AI_OUTPUT" > /dev/tty
        ;;
      w|W)
        # Capture a team preference from a rejected finding, then re-prompt --
        # recording knowledge does not itself decide the commit.
        capture_blocked_preference
        ;;
      e|E)
        [ "${INHOUSECODE_EXPLAIN_ENABLED:-0}" = "1" ] || { printf '  Choose %s.\n' "$choices" > /dev/tty; continue; }
        explain_handoff
        # However the session ended, this run does not turn into a pass. Files
        # may have moved underneath the commit and nothing has re-reviewed them.
        say ""
        info "inhousecode: run the gate (or your commit) again to check the tree as it now stands."
        return $EXIT_BLOCKED
        ;;
      o|O)
        ask answer '  Reason for the override (required): '
        [ -n "$answer" ] || { printf '  A reason is required.\n' > /dev/tty; continue; }
        warn "inhousecode: gates overridden - reason: $answer"
        OVERRIDE_REASON="$answer"
        # The override reason is the clearest statement of a team preference the
        # gate ever gets. Offer to keep it rather than discard it to stderr.
        if [ "${INHOUSECODE_MEMORY_ENABLED:-1}" = "1" ] && has_tty; then
          local record
          ask record $'  Record this as a team preference so it is not flagged again? [y/N] '
          case "$record" in
            y|Y|yes|YES)
              memory_capture_preference "$(gate_findings_context)" "$answer"
              ;;
          esac
        fi
        return $EXIT_PASS
        ;;
      a|A|"") return $EXIT_BLOCKED ;;
      *) printf '  Choose %s.\n' "$choices" > /dev/tty ;;
    esac
  done
}

# The findings this run produced, as plain context for a memory draft. Both
# gates' outputs, findings only, so the draft agent can see what was flagged.
gate_findings_context() {
  {
    [ -n "$STATIC_OUTPUT" ] &&
      select_findings "$STATIC_OUTPUT" "$STATIC_FINDING_MARKER" all |
        awk -F'\t' 'NF>=5 { printf "- [static][%s] %s | %s\n", $2, $3, $4 }'
    [ -n "$AI_OUTPUT" ] &&
      select_findings "$AI_OUTPUT" "$AI_FINDING_MARKER" all |
        awk -F'\t' 'NF>=5 { printf "- [review][%s] %s | %s\n", $2, $3, $4 }'
  } 2>/dev/null
}

# The [w] handler at the blocked prompt: let the developer point at a finding
# they disagree with, then capture the preference through the option-(c) flow.
capture_blocked_preference() {
  local context
  context="$(gate_findings_context)"
  if [ -n "$context" ]; then
    printf '\n  Findings from this run:\n%s\n' "$context" > /dev/tty
  fi
  memory_capture_preference "$context"
}

cmd_review() {
  parse_review_args "$@"
  require_repo
  load_config || exit $EXIT_USAGE
  [ -n "$PR_REFERENCE" ] && resolve_pr_target
  [ -n "$TICKET_REFERENCE" ] && resolve_ticket_target
  [ -n "$INTENT_FILE" ] && resolve_intent_file
  [ "$ADVERSARIAL_REQUESTED" = "1" ] && enable_adversarial
  [ "$TARGET_MODE" = "diff" ] && resolve_diff_base
  prepare_cache

  # Resolve --fix, --no-fix, and the repository's opt-in default before target
  # safety can turn a diff/PR review back into report-only mode.
  # shellcheck source=../lib/fix_policy.sh
  source "$INHOUSECODE_HOME/lib/fix_policy.sh"
  fix_policy_apply

  # Reviewing a pull request means judging someone else's committed work: the
  # default is to report, not to rewrite their branch under them.
  if [ "$TARGET_MODE" = "diff" ] && [ "$FIX_REQUESTED" != "1" ]; then
    NO_FIX=1
    info "inhousecode: this is a report-only review; pass --fix to allow repairs."
  fi
  # A fixer edits the working tree. If the commit under review is not the one
  # checked out, those edits would land on unrelated code.
  if [ "$TARGET_MODE" = "diff" ] && [ "$NO_FIX" != "1" ] &&
      [ "$DIFF_HEAD" != "$(git rev-parse --verify --quiet HEAD)" ]; then
    NO_FIX=1
    warn "inhousecode: the reviewed commit is not checked out; repairs are disabled."
    warn "  Check the branch out first if you want it fixed: git switch <branch>"
  fi

  if [ "$NO_FIX" = "1" ]; then
    INHOUSECODE_FIX_ALL=0
    INHOUSECODE_STATIC_AUTOFIX=0
    INHOUSECODE_AI_AUTOFIX_BLOCKING=0
    INHOUSECODE_AI_TRIAGE_FINDINGS=0
  elif [ "$TARGET_MODE" = "diff" ]; then
    # Repairs are written to the working tree, so from here on that is the
    # subject of every re-scan and re-review; otherwise a repair round would
    # be invisible to the next one and the loop would stall on "no progress".
    DIFF_SOURCE="worktree"
  fi
  [ "$GATE_MODE" = "ai" ] && INHOUSECODE_STATIC_ENABLED=0
  [ "$GATE_MODE" = "static" ] && INHOUSECODE_AI_ENABLED=0

  collect_target_files || { fail "inhousecode: could not enumerate the review target."; exit $EXIT_USAGE; }
  if [ "$TARGET_FILE_COUNT" -eq 0 ]; then
    good "inhousecode: nothing to review ($TARGET_MODE)."
    exit $EXIT_PASS
  fi

  local target_label="$TARGET_MODE"
  if [ "$TARGET_MODE" = "diff" ]; then
    target_label="diff vs $DIFF_BASE @ ${DIFF_MERGE_BASE:0:9}"
    [ -n "$PR_ID" ] && target_label="PR #$PR_ID vs $DIFF_BASE"
    # The gates read the reviewed commit; a repair round edits the working tree.
    if [ "$NO_FIX" != "1" ] && [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      warn "inhousecode: the working tree is dirty; repairs would mix with those changes."
    fi
  fi
  say "${C_BOLD}inhousecode${C_RESET} $VERSION - reviewing $TARGET_FILE_COUNT file(s) [$target_label]"

  # shellcheck source=../lib/copilot.sh
  source "$INHOUSECODE_HOME/lib/copilot.sh"
  usage_reset
  # shellcheck source=../lib/impact.sh
  source "$INHOUSECODE_HOME/lib/impact.sh"
  # shellcheck source=../lib/gate_static.sh
  source "$INHOUSECODE_HOME/lib/gate_static.sh"
  # shellcheck source=../lib/gate_ai.sh
  source "$INHOUSECODE_HOME/lib/gate_ai.sh"
  # shellcheck source=../lib/gate_adversarial.sh
  source "$INHOUSECODE_HOME/lib/gate_adversarial.sh"
  # shellcheck source=../lib/explain.sh
  source "$INHOUSECODE_HOME/lib/explain.sh"
  # shellcheck source=../lib/memory.sh
  source "$INHOUSECODE_HOME/lib/memory.sh"

  if [ "$INHOUSECODE_STATIC_ENABLED" = "1" ] && [ "$INHOUSECODE_STATIC_AUTOFIX" = "1" ]; then
    ensure_copilot || INHOUSECODE_STATIC_AUTOFIX=0
  fi

  run_static_gate
  run_ai_gate

  print_summary
  explain_persist_briefing
  explain_print_finding_details auto
  if gates_blocked; then
    local blocked_rc
    resolve_blocked
    blocked_rc=$?
    if [ "$blocked_rc" -eq "$EXIT_PASS" ]; then
      memory_record_session "overridden" "$OVERRIDE_REASON"
    else
      memory_record_session "blocked"
    fi
    exit "$blocked_rc"
  fi
  # A passing run that ends with a modified tree has not actually been reviewed:
  # the session's edits landed after the verdict. Re-run rather than wave it on.
  if [ "${EXPLAIN_TREE_CHANGED:-0}" = "1" ]; then
    warn "inhousecode: the session changed files after the gates ran."
    info "inhousecode: run the gate (or your commit) again to check the tree as it now stands."
    memory_record_session "blocked"
    exit $EXIT_BLOCKED
  fi
  memory_record_session "pass"
  good "inhousecode: PASS"
  exit $EXIT_PASS
}

# --- explain -----------------------------------------------------------------

cmd_show() {
  require_repo
  resolve_python || { fail "inhousecode: Python 3 is required."; exit $EXIT_USAGE; }
  local number="${1:-}" color="auto"
  [ "$#" -gt 0 ] && shift
  case "$number" in
    ''|*[!0-9]*|0) fail "inhousecode: show needs a positive finding number."; exit $EXIT_USAGE ;;
  esac
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --color)
        shift
        case "${1:-}" in auto|always|never) color="$1" ;;
          *) fail "inhousecode: --color must be auto, always, or never."; exit $EXIT_USAGE ;;
        esac
        ;;
      *) fail "inhousecode: unknown show option '$1'."; exit $EXIT_USAGE ;;
    esac
    shift
  done
  local briefing="$REPO_ROOT/.inhousecode/cache/last-briefing.md"
  [ -s "$briefing" ] || {
    fail "inhousecode: no findings briefing yet. Run 'inhousecode review' first."
    exit $EXIT_USAGE
  }
  "${PYTHON_CMD[@]}" "$INHOUSECODE_HOME/lib/finding_view.py" \
    --briefing "$briefing" --finding "$number" --color "$color"
}

# Standalone entry point for the developer who aborted and thought better of it.
# It replays the last briefing rather than re-running the gates, so it costs
# nothing and always reflects the run the developer actually saw.
cmd_explain() {
  require_repo
  load_config || exit $EXIT_USAGE
  # shellcheck source=../lib/copilot.sh
  source "$INHOUSECODE_HOME/lib/copilot.sh"
  # shellcheck source=../lib/explain.sh
  source "$INHOUSECODE_HOME/lib/explain.sh"

  local briefing
  briefing="$(explain_briefing_path)"
  if [ ! -s "$briefing" ]; then
    fail "inhousecode: no findings briefing yet. Run 'inhousecode review' first."
    exit $EXIT_USAGE
  fi
  if [ "${INHOUSECODE_EXPLAIN_ENABLED:-0}" != "1" ]; then
    fail "inhousecode: explain is disabled (explain.enabled is false)."
    exit $EXIT_USAGE
  fi
  explain_launch_session "$briefing"
  exit $EXIT_PASS
}

# --- init --------------------------------------------------------------------

cmd_init() {
  require_repo
  local dir="$REPO_ROOT/.inhousecode"
  mkdir -p "$dir" || exit $EXIT_USAGE

  if [ -f "$dir/config.json" ]; then
    info "inhousecode: $dir/config.json already exists; leaving it alone."
  else
    cp "$INHOUSECODE_HOME/config/review.config.default.json" "$dir/config.json"
    good "inhousecode: wrote $dir/config.json"
  fi
  load_config || exit $EXIT_USAGE
  # shellcheck source=../lib/memory.sh
  source "$INHOUSECODE_HOME/lib/memory.sh"
  if [ "${INHOUSECODE_MEMORY_ENABLED:-1}" = "1" ]; then
    memory_init || {
      fail "inhousecode: OpenViking memory initialization failed; no local fallback was created."
      exit $EXIT_USAGE
    }
  fi
  if ! grep -qs '^\.inhousecode/cache/' "$REPO_ROOT/.gitignore"; then
    printf '\n# inhousecode scratch space\n.inhousecode/cache/\n' >> "$REPO_ROOT/.gitignore"
    good "inhousecode: ignored .inhousecode/cache/"
  fi
  say ""
  say "Next: add repository knowledge with 'inhousecode memory candidate add', then run 'inhousecode install-hooks'."
  say "Or run 'inhousecode discover' to propose repository knowledge as candidates."
}

# --- memory --------------------------------------------------------------------

cmd_memory() {
  require_repo
  load_config || exit $EXIT_USAGE
  # shellcheck source=../lib/memory.sh
  source "$INHOUSECODE_HOME/lib/memory.sh"

  local sub="${1:-view}"
  [ "$#" -gt 0 ] && shift
  case "$sub" in
    init) memory_init || exit $EXIT_USAGE ;;
    candidate)
      [ "${1:-}" = "add" ] && [ "$#" -ge 2 ] || {
        fail "inhousecode: usage: memory candidate add <text> [--source <s>] [--evidence <file:line>]..."; exit $EXIT_USAGE;
      }
      shift
      memory_candidate_add "$@" || exit $EXIT_USAGE
      ;;
    view) memory_run view "$@" || exit $EXIT_USAGE ;;
    context) memory_run context "$@" || exit $EXIT_USAGE ;;
    classify)
      [ "$#" -ge 1 ] || { fail "inhousecode: memory classify needs a candidate ID."; exit $EXIT_USAGE; }
      memory_classify "$@" || exit $EXIT_USAGE
      ;;
    promote)
      [ "$#" -ge 1 ] || { fail "inhousecode: memory promote needs a candidate ID."; exit $EXIT_USAGE; }
      memory_promote "$@" || exit $EXIT_USAGE
      ;;
    harvest) memory_harvest "$@" || exit $EXIT_USAGE ;;
    schedule)
      local action="${1:-status}"
      [ "$#" -gt 0 ] && shift
      case "$action" in
        install)
          "${PYTHON_CMD[@]}" "$INHOUSECODE_HOME/lib/harvest_schedule.py" install \
            "$REPO_ROOT" "$INHOUSECODE_HOME/bin/inhousecode" "$@" || exit $EXIT_USAGE ;;
        uninstall|status)
          "${PYTHON_CMD[@]}" "$INHOUSECODE_HOME/lib/harvest_schedule.py" "$action" \
            "$REPO_ROOT" "$@" || exit $EXIT_USAGE ;;
        *) fail "inhousecode: usage: memory schedule install|uninstall|status"; exit $EXIT_USAGE ;;
      esac
      ;;
    *) fail "inhousecode: unknown memory subcommand '$sub'."; exit $EXIT_USAGE ;;
  esac
}

# --- harness-native command integrations -------------------------------------

cmd_integrate() {
  resolve_python || { fail "inhousecode: Python 3 is required for integrations."; exit $EXIT_USAGE; }
  local action="${1:-status}" harness="${2:-all}"
  case "$action" in
    install|status|uninstall) ;;
    *) fail "inhousecode: integrate action must be install, status, or uninstall."; exit $EXIT_USAGE ;;
  esac
  case "$harness" in
    hermes|codex|all) ;;
    *) fail "inhousecode: integrate harness must be hermes, codex, or all."; exit $EXIT_USAGE ;;
  esac
  local targets=() target
  if [ "$harness" = "all" ]; then targets=(hermes codex); else targets=("$harness"); fi
  for target in "${targets[@]}"; do
    "${PYTHON_CMD[@]}" "$INHOUSECODE_HOME/lib/integrations.py" \
      "$action" "$target" --source "$INHOUSECODE_HOME/skills/inhousecode" || exit $EXIT_USAGE
  done
}

# --- discover --------------------------------------------------------------------
#
# A one-shot agent run that reads the repository -- its manifests, its linter
# and CI config, its existing documentation, its directory layout -- and proposes
# first pass at two things a blank .inhousecode/ leaves the team to write by
# hand: which Semgrep packs actually fit this stack, and what durable facts
# belong in team memory before the first real review ever runs.
#
# It never writes approved memory itself. It records candidate knowledge as
# proposals, so a developer can evaluate and approve it later.
cmd_discover() {
  require_repo
  load_config || exit $EXIT_USAGE
  GATE_ONLY=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --gate) GATE_ONLY=1 ;;
      -h|--help) usage; exit $EXIT_PASS ;;
      *) fail "inhousecode: unknown option '$1'."; exit $EXIT_USAGE ;;
    esac
    shift
  done

  # shellcheck source=../lib/copilot.sh
  source "$INHOUSECODE_HOME/lib/copilot.sh"
  # shellcheck source=../lib/memory.sh
  source "$INHOUSECODE_HOME/lib/memory.sh"
  usage_reset
  ensure_copilot || { fail "inhousecode: the AI harness is required for discover."; exit $EXIT_USAGE; }

  local skill="$INHOUSECODE_HOME/skills/discovery/SKILL.md"
  memory_init >/dev/null || {
    fail "inhousecode: OpenViking memory is required for discovery."
    exit $EXIT_USAGE
  }

  local mode_line
  if [ "$GATE_ONLY" = "1" ]; then
    mode_line="Report-only: do not write anything. Print candidate records under a PROPOSED CANDIDATE MEMORY heading."
  else
    mode_line="Record each repository fact as unverified candidate memory by running, once per fact, from a shell in $REPO_ROOT:
  $INHOUSECODE_HOME/bin/inhousecode memory candidate add \"<candidate>\"
Do not call OpenViking directly. Do not classify or promote candidates."
  fi

  step "Discovering this repository..."
  local prompt
  prompt="$(printf '%s\n' \
    "You are onboarding inhousecode onto a repository for the first time. Read" \
    "the repository at $REPO_ROOT and identify its languages, frameworks, package" \
    "manager, test runner, linter/CI configuration, architecture, and existing" \
    "README, CONTRIBUTING, AGENTS.md, CLAUDE.md, and Copilot instructions." \
    "" \
    "Reference material for this task: $skill" \
    "" \
    "$mode_line" \
    "" \
    "Human authorship does not prove correctness. Every discovered fact starts" \
    "as candidate memory. Include repository evidence in your final summary." \
    "" \
    "When done, print a short summary of the stack and candidate records.")"

  local log="$REPO_ROOT/.inhousecode/cache/discover-$$.log"
  mkdir -p "$REPO_ROOT/.inhousecode/cache" 2>/dev/null
  run_discover_agent "$prompt" "$log" "discover"
  say ""
  agent_text "$log"
  say ""
  print_usage_summary
  rm -f "$log" 2>/dev/null
  exit $EXIT_PASS
}

# --- hooks -------------------------------------------------------------------

install_pre_commit() {
  local hooks_dir="$REPO_ROOT/$HOOKS_DIR" hook current
  mkdir -p "$hooks_dir" || return 1
  hook="$hooks_dir/pre-commit"
  # A shim, not a copy: the installed project stays the single source of truth,
  # so upgrading inhousecode never requires reinstalling hooks.
  cat > "$hook" <<EOF
#!/usr/bin/env bash
# Installed by inhousecode. Edit the tool, not this shim.
exec "$INHOUSECODE_HOME/bin/inhousecode" review --staged "\$@"
EOF
  chmod +x "$hook" || return 1

  # core.hooksPath is a single value shared with every other hook manager in the
  # repository -- husky, lefthook, pre-commit. Pointing it here silently
  # disables every hook they installed, and the damage is invisible: commits
  # keep succeeding, just without the checks the team thought they had. So it is
  # never overwritten. A gate that disables other gates behind your back has no
  # business calling itself a gate.
  current="$(git config --get core.hooksPath 2>/dev/null)" || current=""
  if [ -z "$current" ]; then
    git config core.hooksPath "$HOOKS_DIR" || return 1
    good "inhousecode: installed $hook"
    return 0
  fi
  if [ "$current" = "$HOOKS_DIR" ]; then
    good "inhousecode: installed $hook"
    return 0
  fi

  warn "inhousecode: core.hooksPath already points at '$current' - leaving it alone."
  warn "  The shim is written but will NOT run until it is wired in. Either:"
  warn "    - call it from your existing hook:"
  warn "        exec \"$INHOUSECODE_HOME/bin/inhousecode\" review --staged"
  warn "    - or take over hooks entirely: git config core.hooksPath $HOOKS_DIR"
  return 0
}

install_agent_stop() {
  local dir="$REPO_ROOT/.github/hooks" target
  mkdir -p "$dir" || return 1
  target="$dir/inhousecode.json"
  sed -e "s|@INHOUSECODE_HOME@|$INHOUSECODE_HOME|g" \
    "$INHOUSECODE_HOME/hooks/copilot-hooks.template.json" > "$target" || return 1
  good "inhousecode: installed $target (Copilot CLI agentStop hook)"
  info "  Restart your Copilot CLI session to load it; check with /env."
}

cmd_install_hooks() {
  require_repo
  load_config || exit $EXIT_USAGE
  local want_pre_commit=0 want_agent_stop=0
  if [ "$#" -eq 0 ]; then
    want_pre_commit="$INHOUSECODE_TRIGGERS_PRE_COMMIT"
    want_agent_stop="$INHOUSECODE_TRIGGERS_AGENT_STOP"
  fi
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --pre-commit) want_pre_commit=1 ;;
      --agent-stop) want_agent_stop=1 ;;
      *) fail "inhousecode: unknown option '$1'."; exit $EXIT_USAGE ;;
    esac
    shift
  done
  [ "$want_pre_commit" = "1" ] && { install_pre_commit || exit $EXIT_USAGE; }
  [ "$want_agent_stop" = "1" ] && { install_agent_stop || exit $EXIT_USAGE; }
  if [ "$want_pre_commit" != "1" ] && [ "$want_agent_stop" != "1" ]; then
    warn "inhousecode: no trigger selected; nothing installed."
  fi
}

cmd_uninstall_hooks() {
  require_repo
  local hook="$REPO_ROOT/$HOOKS_DIR/pre-commit"
  local agent_hook="$REPO_ROOT/.github/hooks/inhousecode.json"
  local current
  if [ -f "$hook" ] && grep -q 'Installed by inhousecode' "$hook"; then
    rm -f -- "$hook" && good "inhousecode: removed $hook"
    # Clear the pointer only when it is still ours and the directory is empty.
    # Another manager's value was never overwritten on the way in, so unsetting
    # it here would break hooks this tool never owned -- and uninstalling a
    # thing must not leave the repository worse than never installing it.
    current="$(git config --get core.hooksPath 2>/dev/null)" || current=""
    if [ "$current" = "$HOOKS_DIR" ] &&
        [ -z "$(ls -A "$REPO_ROOT/$HOOKS_DIR" 2>/dev/null)" ]; then
      git config --unset core.hooksPath 2>/dev/null
    fi
  fi
  [ -f "$agent_hook" ] && rm -f -- "$agent_hook" &&
    good "inhousecode: removed $agent_hook"
  return 0
}

# --- doctor ------------------------------------------------------------------

check() {
  local label="$1" detail="$2" ok="$3"
  if [ "$ok" = "0" ]; then
    good "  OK    $label${detail:+ - $detail}"
  else
    warn "  MISS  $label${detail:+ - $detail}"
  fi
}

cmd_doctor() {
  say "${C_BOLD}inhousecode $VERSION${C_RESET}  ($INHOUSECODE_HOME)"
  step "Environment"

  # Load the install-wide default so the harness check works outside a repo.
  if resolve_python; then
    local _defaults
    _defaults="$("${PYTHON_CMD[@]}" -c "
import json, sys
with open(sys.argv[1]) as f: cfg = json.load(f)
print(cfg.get('harness', 'copilot'))
" "$INHOUSECODE_HOME/config/review.config.default.json" 2>/dev/null)" || _defaults=""
    INHOUSECODE_HARNESS="${INHOUSECODE_HARNESS:-${_defaults:-copilot}}"
  else
    INHOUSECODE_HARNESS="${INHOUSECODE_HARNESS:-copilot}"
  fi

  local repo_root repo_rc
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
  repo_rc=$?
  check "git repository" "$repo_root" "$repo_rc"
  if [ "$repo_rc" -eq 0 ]; then
    REPO_ROOT="$repo_root"
    export REPO_ROOT
    # Resolve the harness from the repository config before checking it. The
    # repository choice must be visible in doctor, not only during review.
    load_config >/dev/null 2>&1 || true
  fi

  if resolve_python; then
    check "python 3" "$(${PYTHON_CMD[*]} --version 2>&1)" 0
  else
    check "python 3" "required for the static gate" 1
  fi

  if command -v semgrep >/dev/null 2>&1; then
    check "semgrep" "$(semgrep --version 2>/dev/null)" 0
  else
    check "semgrep" "install with: pip install semgrep" 1
  fi

  local copilot
  if copilot="$(resolve_harness)"; then
    check "AI harness (${INHOUSECODE_HARNESS:-copilot})" "$copilot" 0
  else
    check "AI harness (${INHOUSECODE_HARNESS:-copilot})" "required for the AI gate and all repairs" 1
  fi

  if resolve_timeout; then
    check "timeout" "$TIMEOUT_BIN" 0
  else
    check "timeout" "GNU coreutils timeout bounds agent runs" 1
  fi

  # Optional: only --pr needs these, and only for the matching forge.
  if command -v gh >/dev/null 2>&1; then
    check "gh (GitHub PRs)" "$(gh --version 2>/dev/null | head -1)" 0
  else
    check "gh (GitHub PRs)" "optional; needed by --pr on GitHub" 1
  fi
  if command -v az >/dev/null 2>&1; then
    check "az (Azure DevOps PRs)" "optional; needs the azure-devops extension" 0
  else
    check "az (Azure DevOps PRs)" "optional; needed by --pr on Azure DevOps" 1
  fi

  if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    export REPO_ROOT
    step "Repository configuration"
    if load_config; then
      good "  Config resolved."
      say "    harness: $INHOUSECODE_HARNESS"
      say "    review : fixByDefault=$INHOUSECODE_REVIEW_FIX_BY_DEFAULT"
      say "    static : enabled=$INHOUSECODE_STATIC_ENABLED autofix=$INHOUSECODE_STATIC_AUTOFIX maxLoops=$INHOUSECODE_STATIC_MAX_FIX_LOOPS"
      say "    ai     : enabled=$INHOUSECODE_AI_ENABLED autofixBlocking=$INHOUSECODE_AI_AUTOFIX_BLOCKING triageFindings=$INHOUSECODE_AI_TRIAGE_FINDINGS"
      if [ "${INHOUSECODE_ADVERSARIAL_ENABLED:-0}" = "1" ]; then
        say "    advers.: enabled model=${INHOUSECODE_ADVERSARIAL_MODEL:-<primary review model>} maxLenses=${INHOUSECODE_ADVERSARIAL_MAX_LENSES:-4}"
      else
        say "    advers.: disabled (enable in config or pass --adversarial)"
      fi

      # shellcheck source=../lib/memory.sh
      source "$INHOUSECODE_HOME/lib/memory.sh"
      if memory_run check >/dev/null 2>&1; then
        good "    memory  : OpenViking healthy; shared namespace readable"
      else
        fail "    memory  : OpenViking unavailable or namespace unreadable (no local fallback)"
      fi
    fi
    step "Installed triggers"
    [ -f "$REPO_ROOT/.githooks/pre-commit" ] &&
      good "  pre-commit installed" || info "  pre-commit not installed"
    [ -f "$REPO_ROOT/.github/hooks/inhousecode.json" ] &&
      good "  agent-stop installed" || info "  agent-stop not installed"
  fi
}

# --- dispatch ----------------------------------------------------------------

main() {
  local command="${1:-help}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    review)          cmd_review "$@" ;;
    show)            cmd_show "$@" ;;
    explain)         cmd_explain "$@" ;;
    init)            cmd_init "$@" ;;
    install-hooks)   cmd_install_hooks "$@" ;;
    uninstall-hooks) cmd_uninstall_hooks "$@" ;;
    memory)          cmd_memory "$@" ;;
    integrate)       cmd_integrate "$@" ;;
    discover)        cmd_discover "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    version|--version|-v) say "inhousecode $VERSION" ;;
    help|--help|-h)  usage ;;
    *) fail "inhousecode: unknown command '$command'."; usage; exit $EXIT_USAGE ;;
  esac
}

main "$@"
